<?xml version="1.0" encoding="UTF-8"?>
<sagacity
	xmlns="https://www.sagframe.com/schema/sqltoy-translate"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://www.sagframe.com/schema/sqltoy-translate https://sagframe.github.io/schema/sqltoy-translate.xsd">
	<!-- staffId -> staffName cache, used by the <cache-arg> reverse-match filter demo -->
	<cache-translates>
		<sql-translate cache="staffIdName" datasource="ds0">
			<sql>
			<![CDATA[
				--#not_debug#--
				select STAFF_ID,STAFF_NAME,STATUS
				from SQLTOY_STAFF_INFO
			]]>
			</sql>
		</sql-translate>

		<!-- FIFO dynamic cache (see DynamicCacheTest): NO full load — keys missed in the
		     local FIFOMap are batch-fetched through BigDictDynamicCacheFetch (registered
		     via spring.sqltoy.dynamicCacheFetch in application.yml). maxSize=5 is tiny on
		     purpose: the 6 demo dictionary keys provoke a provable eviction.
		     sid/properties are passed through to the fetcher as-is. -->
		<local-translate cache="bigDictCache" sid="DICT_DETAIL" properties="dictKey,dictName,status"
			keep-alive="3600" dynamic-cache="true" dynamic-cache-initSize="10" dynamic-cache-maxSize="5" />
	</cache-translates>
</sagacity>
